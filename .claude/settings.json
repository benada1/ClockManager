{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet restore:*)",
      "Bash(dotnet --list-sdks)",
      "Bash(dotnet ef migrations list:*)",
      "Bash(npm run build)",
      "Bash(npm run lint)",
      "Bash(npm ci:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(pwsh -NoProfile -File .claude/skills/verify/verify.ps1:*)",
      "PowerShell(dotnet build:*)",
      "PowerShell(dotnet test:*)",
      "PowerShell(dotnet restore:*)",
      "PowerShell(npm run build)",
      "PowerShell(npm run lint)",
      "PowerShell(git status:*)",
      "PowerShell(git diff:*)",
      "PowerShell(git log:*)",
      "PowerShell(pwsh -NoProfile -File .claude/skills/verify/verify.ps1:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(dotnet ef database update:*)",
      "Bash(dotnet ef database drop:*)",
      "PowerShell(git push:*)",
      "PowerShell(git commit:*)",
      "PowerShell(dotnet ef database update:*)",
      "PowerShell(dotnet ef database drop:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "PowerShell(git push --force:*)",
      "PowerShell(git push -f:*)",
      "PowerShell(git reset --hard:*)",
      "Read(**/secrets.json)",
      "Read(**/.env)",
      "Read(**/.env.*)"
    ]
  }
}
