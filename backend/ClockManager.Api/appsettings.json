{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ShiftRules": {
    "MaxOpenShiftHours": 16,
    "ShortShiftSeconds": 60
  },
  "ServerNow": {
    "CacheSeconds": 10
  },
  "TrustedClock": {
    "TimeoutMs": 3000,
    "CrossCheckToleranceMs": 2000,
    "LowPrecisionThresholdMs": 1500,
    "Connection": {
      "PooledConnectionLifetimeSeconds": 300,
      "PooledConnectionIdleTimeoutSeconds": 300,
      "ConnectTimeoutMs": 1500,
      "KeepAlivePingDelaySeconds": 30,
      "KeepAlivePingTimeoutSeconds": 10
    },
    "Warmup": { "Enabled": true, "TimeoutMs": 3000 },
    "Primary": { "Name": "time.now", "BaseUrl": "https://time.now/" },
    "Secondary": { "Name": "timeapi.io", "BaseUrl": "https://timeapi.io/" }
  }
}
